# InfoMentor Fetcher Environment Variables
# Copy this file to .env and fill in your values

# Required: Perplexity API key for LLM processing
# Get this from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-api-key-here

# Optional: Gemini API key for LLM processing
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Required: Telegram configuration
# Create a bot with @BotFather and get the token
# Get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
